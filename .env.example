# Copy to .env.local and fill in. Never commit real values.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token (Viewer) for draft mode / live preview
SANITY_API_READ_TOKEN=
# Shared secret for the publish webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://www.presco-radiator-caps.com
NEXT_PUBLIC_GTM_ID=

# Forms (contact + enquiry)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Write token (Editor) so form submissions are saved to Sanity
SANITY_API_WRITE_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

# Migration only (scripts/migrate-from-wordpress.ts) — remove after cutover
WP_URL=https://bd.presco-radiator-caps.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
